+/* Barra de acciones sobre una selección masiva (Pedidos: Solicitudes y Comparativo) */
+.mod-bulkbar {
+  display: flex;
+  flex-wrap: wrap;
+  align-items: center;
+  gap: 0.5rem;
+  padding: 0.5rem 0.75rem;
+  margin: 0.5rem 0;
+  border: 1px solid var(--color-border-subtle);
+  border-radius: var(--radius-md);
+  background-color: var(--color-selection);
+}
+.mod-bulkbar--sticky {
+  position: sticky;
+  bottom: 0;
+  z-index: 2;
+  background-color: var(--color-surface);
+  box-shadow: var(--shadow-sm);
+}
+/* Celda de selección: ancho mínimo, sin disparar el clic de la fila */
+.mod-table td.mod-check,
+.mod-table th.mod-check {
+  width: 2rem;
+  text-align: center;
+}
+/* Aviso corto bajo la barra de herramientas (resultado de una operación masiva) */
+.mod-notice {
+  margin: 0.5rem 0;
+  padding: 0.375rem 0.75rem;
+  border: 1px solid var(--color-border-subtle);
+  border-radius: var(--radius-md);
+  background-color: var(--color-warning-soft);
+}
+
 /* ---------- Utilidades (al final para ganar empates) ---------- */
 
 .mod-flex { display: flex; }
