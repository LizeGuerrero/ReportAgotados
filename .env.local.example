NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxx

# ⚠️ SOLO servidor. Sin prefijo NEXT_PUBLIC_ a propósito — si se lo pones,
# quedaría expuesta en el navegador. Cópiala de Settings → API → Secret keys.
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxx

# Invitaciones (opcional). Sin esto la invitación se crea igual y el admin copia el enlace.
# NEXT_PUBLIC_SITE_URL=https://miapp.com        # base de los enlaces de invitación
# RESEND_API_KEY=re_xxxxxxxx
# MAIL_FROM="Mi App <no-reply@midominio.com>"
